{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ]
    },
    "Framelink_Figma_MCP": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "figma-developer-mcp",
        "--figma-api-key=\"{env:FIGMA_API_KEY}\"",
        "--stdio"
      ],
      "enabled": true
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**"
    ]
  },
  "permission": {
    "websearch": "allow",
    "webfetch": "allow"
  },
  "model": "openai/gpt-5.5",
  "agent": {
    "relay-deepseek": {
      "description": "Use the relay DeepSeek model through the configured OpenAI-compatible gateway.",
      "mode": "primary",
      "model": "openai/deepseek-chat"
    },
    "local-qwen35-9b": {
      "description": "Use the local Ollama Qwen3.5 Abliterated 9B model.",
      "mode": "primary",
      "model": "ollama/huihui_ai/qwen3.5-abliterated:9b"
    }
  },
  "provider": {
    "openai": {
      "options": {
        "baseURL": "https://hk1.heliumlabz.com/v1",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gpt-5.5": {
          "name": "GPT-5.5",
          "reasoning": true,
          "tool_call": true
        },
        "deepseek-chat": {
          "name": "DeepSeek Chat Relay",
          "tool_call": true
        }
      }
    },
    "ollama": {
      "name": "Ollama",
      "api": "openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "huihui_ai/qwen3.5-abliterated:9b": {
          "name": "Qwen3.5 Abliterated 9B Local",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      }
    }
  }
}
